#!/usr/bin/env bash
#MISE description="Check whether the Mosquitto MQTT test broker is running"
set -o errexit
set -o nounset
set -o pipefail

_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=.mise/tasks/_lib.sh
source "${_script_dir}/../_lib.sh"

if ! detect_runtime; then
	echo 'stopped'
	exit 1
fi

if "$RUNTIME" ps --format '{{.Names}}' 2>/dev/null \
		| grep -qx "$CONTAINER_NAME"; then
	echo 'running'
	exit 0
else
	echo 'stopped'
	exit 1
fi
