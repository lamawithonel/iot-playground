#!/usr/bin/env bash
#MISE description="Run on-device tests via probe-rs (requires connected probe)"
#USAGE arg "<board>" required=#false help="Board name; omit for the IOT_BOARDS pin or default board" {
#USAGE   choices "feather-stm32f405" "nucleo-n657x0"
#USAGE }
# nucleo-h753zi is absent from the choices: it has no tests/ target
# yet (boards/AGENTS.md requires one for active profiles), so
# offering it would print the test banner and pass having run
# nothing.  Add it back with its bring-up test binary.
set -o errexit
set -o nounset
set -o pipefail

_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=.mise/tasks/_boards.sh
source "${_script_dir}/../_boards.sh"

# Precedence: CLI arg, then the task-specific BOARD var, then the
# first entry of an IOT_BOARDS env pin, then the default board.  First
# line via parameter expansion, not `| head -1`: under pipefail,
# head exiting early can SIGPIPE resolve_boards and kill the task.
_board="${usage_board:-${BOARD:-}}"
if [ -z "$_board" ]; then
	_board="$(resolve_boards)"
	_board="${_board%%$'\n'*}"
fi

# embedded-test runs through `probe-rs run`; a loader board cannot,
# by definition.
if [ -n "$(board_loader "$_board")" ]; then
	echo "⏭  ${_board} loads through a loader script, which embedded-test cannot use." >&2
	echo "   Flash it instead with: mise run flash ${_board}" >&2
	exit 0
fi

_probe_output="$(probe-rs list 2>&1)"
if echo "$_probe_output" | grep -q 'No probes were found'; then
	echo '⏭  No debug probe connected — skipping device tests.' >&2
	echo '   Connect a J-Link or compatible SWD probe and retry.' >&2
	exit 0
fi

echo "🔌 Probe detected:"
echo "$_probe_output" | sed 's/^/   /'
echo ""

_target="${TARGET:-$(board_target "$_board")}"
_timeout="${DEVICE_TEST_TIMEOUT:-120}"
# Unconditional: the board under test decides the chip.  The IOT_BOARDS
# bridge (.mise/env.sh) may have exported another board's chip and
# speed clamp from the pin's first entry.
PROBE_RS_CHIP="$(board_chip "$_board")"
export PROBE_RS_CHIP
unset PROBE_RS_SPEED

echo "🧪 Running on-device tests for ${_board} (timeout: ${_timeout}s)..."
echo ""

# No `-- "$@"` passthrough: mise also passes the usage arg
# positionally, so forwarding it would hand the board name to
# cargo test as a test-name filter that matches nothing-- a
# vacuous pass of a testing gate.
_rc=0
timeout "$_timeout" cargo test \
	-p "$_board" \
	--target "$_target" \
	|| _rc=$?

if [ "$_rc" -eq 124 ]; then
	echo "" >&2
	echo "⏰ Device tests timed out after ${_timeout}s." >&2
	exit 1
fi

exit "$_rc"
