#!/usr/bin/env bash
#MISE description="Smoke test: route each board to its suite in test/smoke/"
#USAGE arg "<board>" var=#true required=#false help="Board name(s), or 'all' for the workspace members; omit for the IOT_BOARDS pin or default board" {
#USAGE   choices "all" "feather-stm32f405" "nucleo-h753zi" "nucleo-n657x0"
#USAGE }

# Smoke is a test class, not a board feature: this router only
# resolves which boards to test and dispatches each to its suite at
# test/smoke/<board>.sh (convention; no registry entry needed).  A
# board without a suite skips loudly.  Positional "$@" is used
# instead of usage_board so the tier wrappers, which exec into this
# file without mise's usage parsing, still route their arguments;
# resolve_boards validates either way.

set -o errexit
set -o nounset
set -o pipefail

_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=.mise/tasks/_lib.sh
source "${_script_dir}/../_lib.sh"
# shellcheck source=.mise/tasks/_boards.sh
source "${_script_dir}/../_boards.sh"

# Root suite paths on the script location, not the cwd: a direct
# invocation from a subdirectory must not turn every board into a
# false "no suite" skip.
_repo_root="$(cd "${_script_dir}/../../.." && pwd)"

_boards="$(resolve_boards "$@")"

_rc=0
_ran=0
_total=0
for _b in $_boards; do
	_total=$((_total + 1))
	_suite="${_repo_root}/test/smoke/${_b}.sh"
	if [ -x "$_suite" ]; then
		_ran=$((_ran + 1))
		echo "═══ smoke: ${_b} ═══════════════════════════════"
		if ! "$_suite"; then
			echo "❌ Smoke suite FAILED: ${_b}" >&2
			if [ "$_rc" -eq 0 ]; then
				_rc=1
			fi
		fi
	else
		echo "⏭  ${_b} has no smoke suite yet (expected test/smoke/${_b}.sh)." >&2
	fi
done

# Keep the integration chain's PASSED banner honest: an all-skip
# run passes (skips warn, not block) but must say so on stdout.
if [ "$_ran" -eq 0 ]; then
	echo "⚠️  0 of ${_total} resolved board(s) have a smoke suite-- nothing was smoke-tested."
fi

exit "$_rc"
