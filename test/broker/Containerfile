# Containerfile for Mosquitto MQTT Broker with TLS support
FROM eclipse-mosquitto:2.0

# Copy mosquitto configuration
COPY mosquitto.conf /mosquitto/config/mosquitto.conf

# Create cert mount point
RUN mkdir -p /mosquitto/certs

# Expose ports
EXPOSE 1883 8883

# Bypass the base image's docker-entrypoint.sh which runs
# `chown -R mosquitto:mosquitto /mosquitto`.  That fails when
# cert files are bind-mounted read-only (:ro), preventing
# mosquitto from loading TLS keys.  Running as root is fine
# for a local test broker.
USER root
ENTRYPOINT ["/usr/sbin/mosquitto"]
CMD ["-c", "/mosquitto/config/mosquitto.conf"]
